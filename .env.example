# Local development only. Never expose an unauthenticated server to the Internet.
MCP_WORKSPACE_ROOT=/srv/workspace/my-project
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Recommended for web connectors: no in-memory MCP session or long-lived SSE response.
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
MCP_AUTH_ENABLED=false
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp
MCP_TRANSPORT_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_TRANSPORT_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]

# Public deployments: OAuth resource server and pre-provisioned Gemini OAuth client.
MCP_OAUTH_ISSUER=https://YOUR_TENANT.us.auth0.com/
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_ALLOWED_USER_SUBS=auth0|YOUR_SUBJECT
# Optional self-hosted single-user OAuth, suitable for Gemini + Tailscale Funnel.
MCP_LOCAL_OAUTH_PROVIDER=false
MCP_LOCAL_OAUTH_CLIENT_ID=
MCP_LOCAL_OAUTH_CLIENT_SECRET=
# A missing read scope rejects every tool. Missing write/exec scopes reject those tool groups.
MCP_REQUIRE_OAUTH_SCOPES=true

# "none" provides NO shell isolation. Use "bwrap" on a dedicated Linux runner.
MCP_SANDBOX_MODE=bwrap
MCP_SANDBOX_DISABLE_NET=true
MCP_AUDIT_LOG_PATH=/var/log/remote-agent-mcp/audit.jsonl
MCP_JOBS_DIR=/var/lib/remote-agent-mcp/jobs
MCP_ENABLE_GIT_RESTORE=false
MCP_MAX_CONCURRENT_JOBS=8

# Hardening controls
MCP_STRIP_SENSITIVE_ENV=true
MCP_MAX_COMMAND_CHARS=8192
MCP_MAX_REQUEST_BYTES=10485760
MCP_AUDIT_LOG_MAX_BYTES=10485760
MCP_AUDIT_LOG_BACKUPS=3
# Optional strict command allowlist (JSON array), e.g. ["python","pytest","git"]
MCP_ALLOWED_COMMANDS=[]
# Optional OAuth 2.1 refresh token rotation
MCP_ROTATE_REFRESH_TOKENS=false
